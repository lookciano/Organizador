  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.mjs",
    "check": "tsc --noEmit && node --check server/index.mjs && node --check server/db.mjs && node --check server/ai.mjs && node --check server/topic-summaries.mjs && node --check server/executive-summaries.mjs && node --check server/project-context.mjs && node --check server/structure-csv.mjs && node --check server/second-brain.mjs && node --check server/knowledge.mjs && node --check server/chatask.mjs",
    "test": "node --test server/*.test.mjs",
    "test:integration": "node --test tests/second-brain.integration.mjs",
    "test:ui": "node --test tests/second-brain.ui.mjs",
    "test:local-tidb": "bash scripts/test-local-tidb.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "mammoth": "^1.13.0",
    "mysql2": "^3.14.0",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.2",
    "vite": "^6.3.0"
  }
}
